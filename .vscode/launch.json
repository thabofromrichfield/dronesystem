{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "android",
      "request": "launch",
      "name": "Deploy simDebug to emulator",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "apkFile": "${workspaceRoot}/app/build/outputs/apk/sim/debug/app-sim-debug.apk",
      "adbPort": 5037
    },
    {
      "type": "android",
      "request": "attach",
      "name": "Attach to running app",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "adbPort": 5037,
      "processId": "${command:PickAndroidProcess}"
    }
  ]
}

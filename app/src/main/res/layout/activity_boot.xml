<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghost_black"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/boot_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:letterSpacing="0.35"
        android:text="@string/boot_title"
        android:textColor="@color/ghost_neon"
        android:textSize="26sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/boot_sub"
        android:textColor="@color/ghost_grey"
        android:textSize="10sp"
        android:typeface="monospace" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/ghost_neon_dim" />

    <TextView
        android:id="@+id/boot_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/ghost_green"
        android:textSize="11sp"
        android:typeface="monospace"
        tools:ignore="MissingPrefix" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boot_hint"
        android:textColor="@color/ghost_grey"
        android:textSize="9sp"
        android:typeface="monospace" />

    <Button
        android:id="@+id/boot_init"
        style="@style/Ghost.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/boot_init" />

    <Button
        android:id="@+id/boot_enter"
        style="@style/Ghost.Button.Safe"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="@string/boot_enter"
        android:textSize="15sp" />

    <Button
        android:id="@+id/boot_sim"
        style="@style/Ghost.Button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="10dp"
        android:text="@string/boot_sim" />
</LinearLayout>
